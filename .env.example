# Tokens des forges (aussi configurables dans Paramètres → Forges et tokens, prioritaire).
# GitHub : fine-grained en lecture (Metadata, Contents, Pull requests, Actions) + Issues en écriture
# pour créer des issues. Pour les notifications GitHub perso, il faut un token classique
# avec les scopes repo + notifications. Sans token : 60 requêtes/heure, dépôts publics.
GITHUB_TOKEN=
# GitLab (gitlab.com ou auto-hébergé) : scope api (read_api suffit sans création d'issues).
GITLAB_TOKEN=
# Gitea / Forgejo : adresse de l'instance par défaut et token (repository + issue).
GITEA_URL=
GITEA_TOKEN=

# Notifications push ntfy (se règlent aussi dans Paramètres → Notifications push).
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Adresse de Projectory, pour les liens dans les notifications.
APP_URL=

# Fréquence de synchronisation automatique, en minutes (0 = manuelle uniquement).
SYNC_INTERVAL_MINUTES=30

# Mot de passe (authentification HTTP basique, n'importe quel identifiant).
# Recommandé si l'app est accessible ailleurs que sur ta machine / ton réseau local.
APP_PASSWORD=

# Dossier des sauvegardes automatiques (défaut : /data/backups).
BACKUP_DIR=

# Port exposé sur l'hôte.
PROJECTORY_PORT=3001

# Tag de l'image : latest (dernière release), 1.2.3, 1.2, 1, ou dev (branche main).
PROJECTORY_TAG=latest

# Bouton « Mettre à jour maintenant » : décommente les deux lignes pour lancer
# Watchtower avec Projectory, et choisis un jeton (ex. : openssl rand -hex 32).
# COMPOSE_PROFILES=updater
# WATCHTOWER_TOKEN=
